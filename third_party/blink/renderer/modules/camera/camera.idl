[
  Exposed=Window
] interface Camera {
    [CallWith=ExecutionContext] constructor();
    void setConfig(CameraSettingJson details);	
    [CallWith=ScriptState] Promise<CameraVizioConfig> getConfig(sequence<DOMString> config);
};

