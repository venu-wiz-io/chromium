// https://w3c.github.io/clipboard-apis/#clipboard-interface

[
  Exposed=Window
] interface Camera {
  [CallWith=ExecutionContext] constructor();
    DOMString saneStringFrom(DOMString input);
    void SetConfig(CameraSettingJson details);	
    [CallWith=ScriptState] Promise<void> getConfig(CameraVizioConfig details);
};

