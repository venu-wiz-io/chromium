[
  Exposed=Window
] interface Camera {
    [CallWith=ExecutionContext] constructor();
    [CallWith=ScriptState] void setConfig(sequence<any> config);	
    [CallWith=ScriptState] Promise<sequence<any>> getConfig(sequence<DOMString> config);
};

